# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Saved plan files
*.tfplan
tfplan

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files (often contain sensitive values)
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files
.terraform.tfstate.lock.info

# Ignore CLI configuration files (contains HCP Terraform / TFC API tokens)
.terraformrc
terraform.rc

# Ignore local environment files & keys
.env
.env.*
*.pem
*id_rsa*

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
